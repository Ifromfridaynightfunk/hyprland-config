{
  
    "output": [ "DP-3" ], 
    "height": 41,  
    "margin-top": 5,
    "width": 1700,
    "spacing": 0,

  "modules-left": [
    "custom/distro",
    "hyprland/workspaces",
    
  ],
  "modules-center": [
    "clock",
    "network"
  ],
  "modules-right": [
    "custom/weather",
    "cpu",
    "memory",
    "disk",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "format": "{icon} {windows}",
    "on-click": "activate",
    "sort-by-number": true,
    "format-icons": {
      "1": "◉",
      "2": "◉",
      "3": "◉",
      "4": "◉",
      "5": "◉",
      "6": "◉",
      "default": "■",
      
      }
    },
  "custom/distro": {
    "format": "",
    "on-click": "rofi -show drun",
    "tooltip": false
    },
  "cpu": {
    "format": " {usage}%"
  },
  "memory": {
    "format": "  {used:0.1f}GiB/{total:0.1f}GiB "
  },
  "clock": {
    "format": "  {:%H:%M} "
  },
   "network": {
    "format": "{ifname}",
    "format-wifi": " {essid} | {signalStrength}%",
    "format-ethernet": " 󰈀 {ifname} ",
    "format-disconnected": "   Disconnected",
    "tooltip-format": "{ifname} via {gwaddr}"
   },
   "disk": {
    "format": "  {used}/{total} "
   },
   "custom/power": {
    "format": " ⏻ ",
    "tooltip": false,
    "on-click": "wlogout"
   }
}
